<?xml version="1.0" encoding="utf-8"?>
<!-- Track of the switch in the AirPods notification (layout/notification_connected.xml),
     colored by android:trackTint. Twice as wide as the thumb box, as Switch measures it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@android:color/white" />
    <size
        android:width="48dp"
        android:height="24dp" />
</shape>
